package-as: AzeriteUI6_UnitFrames
enable-nolib-creation: no

externals:
    AzeriteUI6_UnitFrames/Libs/AceAddon-3.0: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
    AzeriteUI6_UnitFrames/Libs/AceDB-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
    AzeriteUI6_UnitFrames/Libs/AceDBOptions-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDBOptions-3.0
    AzeriteUI6_UnitFrames/Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
    AzeriteUI6_UnitFrames/Libs/AceTimer-3.0: https://repos.wowace.com/wow/ace3/trunk/AceTimer-3.0
    AzeriteUI6_UnitFrames/Libs/AceConsole-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
    AzeriteUI6_UnitFrames/Libs/AceHook-3.0: https://repos.wowace.com/wow/ace3/trunk/AceHook-3.0
    AzeriteUI6_UnitFrames/Libs/AceLocale-3.0: https://repos.wowace.com/wow/ace3/trunk/AceLocale-3.0
    AzeriteUI6_UnitFrames/Libs/AceGUI-3.0: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
    AzeriteUI6_UnitFrames/Libs/AceConfig-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0
    AzeriteUI6_UnitFrames/Libs/AceSerializer-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceSerializer-3.0
    AzeriteUI6_UnitFrames/Libs/AceComm-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceComm-3.0
    AzeriteUI6_UnitFrames/Libs/oUF:
      url: git://github.com/oUF-wow/oUF.git
      tag: latest

move-folders:
    AzeriteUI6_UnitFrames/AzeriteUI6_UnitFrames: AzeriteUI6_UnitFrames

tools-used:
  - ouf
  
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

license-output: LICENSE.txt

ignore:
    - CHANGELOG.md
    - CODE_OF_CONDUCT.md
    - LICENSE.md
    - README.md
