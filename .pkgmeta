package-as: AzeriteUI6
enable-nolib-creation: no

move-folders:
    AzeriteUI6/AzeriteUI6: AzeriteUI6

embedded-libraries:
  - ace3
  - libstub
  - libactionbutton-1-0
  - libbuttonglow-1-0
  - ouf

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

license-output: LICENSE.txt

ignore:
    - CHANGELOG.md
    - CODE_OF_CONDUCT.md
    - LICENSE.md
    - README.md
